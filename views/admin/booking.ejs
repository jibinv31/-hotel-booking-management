<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Manage Bookings</title>

    <!-- ✅ Link to Admin Booking Page Styles -->
    <link rel="stylesheet" href="/css/bookings.css">
</head>

<body>

    <!-- ✅ Transparent Header (Matching Home Page) -->
    <header class="header-transparent">
        <h1 class="brand-title">StayEase Admin Panel</h1>
        <p class="brand-subtitle">Manage Your Hotel with Ease</p>

        <!-- ✅ Admin Navigation -->
        <nav>
            <ul>
                <li><a href="/admin/dashboard">Dashboard</a></li>
                <li><a href="/admin/rooms">Manage Rooms</a></li>
                <li><a href="/admin/bookings" class="active">Manage Bookings</a></li>
                <li><a href="/admin/pending-admins">Admin Approvals</a></li>
                <li><a href="/auth/logout" class="nav-logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <!-- ✅ Admin Bookings Page -->
    <div class="booking-page">
        <div class="booking-container">
            <h2>Manage Bookings</h2>

            <% if (bookings.length> 0) { %>
                <table class="table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Room</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(booking=> { %>
                            <tr>
                                <td>
                                    <% if (booking.User) { %>
                                        <%= booking.User.name %> (<%= booking.User.email %>)
                                                <% } else { %>
                                                    <span class="missing-data">No user assigned</span>
                                                    <% } %>
                                </td>

                                <td>
                                    <% if (booking.Room) { %>
                                        <%= booking.Room.room_number %> (<%= booking.Room.type %>)
                                                <% } else { %>
                                                    <span class="missing-data">No room assigned</span>
                                                    <% } %>
                                </td>

                                <td>
                                    <%= new Date(booking.check_in_date).toDateString() %>
                                </td>
                                <td>
                                    <%= new Date(booking.check_out_date).toDateString() %>
                                </td>
                                <td class="status <%= booking.status %>">
                                    <%= booking.status %>
                                </td>

                                <td>
                                    <% if (booking.status==="pending" ) { %>
                                        <form action="/bookings/admin/approve/<%= booking.id %>" method="POST">
                                            <button type="submit" class="btn btn-primary">Approve</button>
                                        </form>
                                        <form action="/bookings/admin/cancel/<%= booking.id %>" method="POST">
                                            <button type="submit" class="btn btn-danger">Cancel</button>
                                        </form>
                                        <% } else { %>
                                            <span class="no-actions">No actions available</span>
                                            <% } %>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
                <% } else { %>
                    <p class="no-bookings">No bookings available.</p>
                    <% } %>
        </div>
    </div>

    <!-- ✅ Footer -->
    <footer>
        <p>&copy; 2025 StayEase. All rights reserved.</p>
    </footer>

</body>

</html>
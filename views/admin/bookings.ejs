<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Manage Bookings</title>

    <!-- ✅ Link to Admin Booking Page Styles -->
    <link rel="stylesheet" href="/css/style1.css">
</head>

<body>

    <!-- ✅ Admin Navigation Bar -->
    <header class="admin-header">
        <nav>
            <ul>
                <li><a href="/admin/dashboard">Dashboard</a></li>
                <li><a href="/admin/rooms">Manage Rooms</a></li>
                <li><a href="/admin/bookings">Manage Bookings</a></li>
                <li><a href="/admin/pending-admins">Admin Approvals</a></li>
                <li><a href="/auth/logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div class="admin-bookings">
        <h2>Manage Bookings</h2>
        <table>
            <tr>
                <th>User</th>
                <th>Room</th>
                <th>Check-in</th>
                <th>Check-out</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
            <% bookings.forEach(booking=> { %>
                <tr>
                    <td>
                        <%= booking.User.name %> (<%= booking.User.email %>)
                    </td>
                    <td>
                        <%= booking.Room.room_number %> (<%= booking.Room.type %>)
                    </td>
                    <td>
                        <%= booking.check_in_date %>
                    </td>
                    <td>
                        <%= booking.check_out_date %>
                    </td>
                    <td>
                        <%= booking.status %>
                    </td>
                    <td>
                        <% if (booking.status==="pending" ) { %>
                            <form action="/bookings/admin/approve/<%= booking.id %>" method="POST">
                                <button type="submit">Approve</button>
                            </form>
                            <form action="/bookings/admin/cancel/<%= booking.id %>" method="POST">
                                <button type="submit">Cancel</button>
                            </form>
                            <% } %>
                    </td>
                </tr>
                <% }); %>
        </table>
    </div>

    <footer>
        <p>&copy; 2025 StayEase. All rights reserved.</p>
    </footer>

</body>

</html>
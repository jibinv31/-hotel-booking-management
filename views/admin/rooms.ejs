<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Manage Rooms</title>

    <!-- PWA Manifest and Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/icons/favicon-96x96.png">
    <link rel="manifest" href="/manifest.json">

    <!-- ✅ Link to custom Bootstrap and original styles -->
    <link rel="stylesheet" href="/css/bootstrap-custom.css">
    <link rel="stylesheet" href="/css/style1.css">
</head>

<body>
    <header class="header-transparent text-center">
        <h1 class="brand-title">StayEase Admin Panel</h1>
        <nav>
            <ul class="nav justify-content-center">
                <li class="nav-item"><a class="nav-link" href="/admin/dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link active" href="/admin/rooms">Manage Rooms</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/bookings">Manage Bookings</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/pending-admins">Admin Approvals</a></li>
                <li class="nav-item"><a class="nav-link text-danger" href="/auth/logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div class="admin-container">
        <h2 class="text-center mb-4">Manage Rooms</h2>

        <!-- ✅ Add New Room Form -->
        <div class="admin-form">
            <h3>Add Room</h3>
            <form action="/admin/rooms/create" method="POST">
                <div class="row mb-2">
                    <div class="col-md-3">
                        <label>Room Number:</label>
                        <input type="text" class="form-control" name="room_number" required>
                    </div>
                    <div class="col-md-3">
                        <label>Type:</label>
                        <input type="text" class="form-control" name="type" required>
                    </div>
                    <div class="col-md-3">
                        <label>Price:</label>
                        <input type="number" class="form-control" name="price" required>
                    </div>
                    <div class="col-md-3">
                        <label>Status:</label>
                        <select class="form-control" name="status">
                            <option value="available">Available</option>
                            <option value="booked">Booked</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Add Room</button>
            </form>
        </div>

        <!-- ✅ Existing Rooms Section -->
        <div class="table-container">
            <h3>Existing Rooms</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Room Number</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% rooms.forEach(room=> { %>
                        <tr>
                            <td>
                                <%= room.room_number %>
                            </td>
                            <td>
                                <%= room.type %>
                            </td>
                            <td>$<%= room.price %>
                            </td>
                            <td>
                                <%= room.status %>
                            </td>
                            <td>
                                <button class="btn btn-primary"
                                    onclick="openEditModal('<%= room.id %>', '<%= room.room_number %>', '<%= room.type %>', '<%= room.price %>', '<%= room.status %>')">
                                    Edit
                                </button>
                                <form action="/admin/rooms/delete/<%= room.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ✅ Edit Room Modal -->
    <div class="modal fade" id="editRoomModal" tabindex="-1" aria-labelledby="editRoomModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoomModalLabel">Edit Room</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="edit-room-form" action="" method="POST">
                        <input type="hidden" id="edit-room-id" name="id">

                        <label>Room Number</label>
                        <input type="text" id="edit-room-number" name="room_number" required>

                        <label>Type</label>
                        <input type="text" id="edit-room-type" name="type" required>

                        <label>Price</label>
                        <input type="number" id="edit-room-price" name="price" required>

                        <label>Status</label>
                        <select id="edit-room-status" name="status">
                            <option value="available">Available</option>
                            <option value="booked">Booked</option>
                        </select>

                        <button type="submit" class="btn btn-success">Update Room</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ Load Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function openEditModal(id, number, type, price, status) {
            let form = document.getElementById("edit-room-form");
            if (!form) {
                console.error("❌ Edit form not found!");
                return;
            }
            form.action = `/admin/rooms/edit/${id}`;
            document.getElementById("edit-room-number").value = number;
            document.getElementById("edit-room-type").value = type;
            document.getElementById("edit-room-price").value = price;
            document.getElementById("edit-room-status").value = status;

            // ✅ Ensure Bootstrap is loaded before opening modal
            if (typeof bootstrap === "undefined") {
                console.error("❌ Bootstrap is not loaded! Make sure the Bootstrap JS is included.");
                return;
            }

            let modalElement = document.getElementById("editRoomModal");
            let modal = new bootstrap.Modal(modalElement);
            modal.show();
        }
    </script>

    <!-- ✅ Register Service Worker for PWA -->
    <script>
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
                navigator.serviceWorker.register("/service-worker.js")
                    .then(() => console.log("Service Worker Registered"))
                    .catch(err => console.log("Service Worker Registration Failed", err));
            });
        }
    </script>

</body>

</html>
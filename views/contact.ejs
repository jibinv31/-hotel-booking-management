<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - StayEase</title>
    <link rel="stylesheet" href="/css/contactpage.css">
</head>

<body>
    <header class="header-transparent">
        <h1 class="brand-title">StayEase</h1>
        <nav>
            <ul class="nav-list">
                <li><a href="/">Home</a></li>
                <li><a href="/rooms">Rooms</a></li>
                <li><a href="/bookings">Bookings</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/auth/logout" class="nav-logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div class="contact-container">
        <div class="contact-info">
            <h2>Get in Touch</h2>
            <p><strong>Address:</strong> 123 Luxury Lane, Suite 456, Toronto, ON, Canada</p>
            <p><strong>Phone:</strong> +1 987-654-3210</p>
            <p><strong>Email:</strong> support@stayease.com</p>
        </div>

        <div class="contact-form">
            <h2>Send Us a Message</h2>
            <form action="/contact/submit" method="POST">
                <div class="form-group">
                    <label for="name">First Name</label>
                    <input type="text" id="name" name="name" required>
                </div>

                <div class="form-group">
                    <label for="lastname">Last Name</label>
                    <input type="text" id="lastname" name="lastname" required>
                </div>

                <div class="form-group">
                    <label for="email">Your Email</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input type="text" id="subject" name="subject" required>
                </div>

                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" rows="4" required></textarea>
                </div>

                <button type="submit" class="btn-primary">Submit</button>
            </form>
        </div>
    </div>

    <footer>
        <p>&copy; 2025 StayEase. All rights reserved.</p>
    </footer>
</body>

</html>
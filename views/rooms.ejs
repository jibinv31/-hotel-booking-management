<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Available Rooms - StayEase</title>

    <!-- PWA Manifest and Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/icons/favicon-96x96.png">
    <link rel="manifest" href="/manifest.json">

    <link rel="stylesheet" href="/css/rooms.css" />
</head>

<body>
    <header class="header-transparent">
        <h1 class="brand-title">Available Rooms</h1>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/bookings">Bookings</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/auth/logout" class="nav-logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">
        <h2>Choose Your Room</h2>

        <table class="table">
            <thead>
                <tr>
                    <th>Room Number</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Select Dates</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% rooms.forEach(room=> { %>
                    <tr>
                        <td>
                            <%= room.room_number %>
                        </td>
                        <td>
                            <%= room.type %>
                        </td>
                        <td>$<%= parseFloat(room.price).toFixed(2) %>
                        </td>
                        <td>
                            <form action="/bookings/create" method="POST">
                                <input type="hidden" name="room_id" value="<%= room.id %>">

                                <!-- ✅ Updated Check-in and Check-out date selection -->
                                <label for="check_in_date_<%= room.id %>">Check-in:</label>
                                <input type="date" id="check_in_date_<%= room.id %>" name="check_in_date" required>

                                <label for="check_out_date_<%= room.id %>">Check-out:</label>
                                <input type="date" id="check_out_date_<%= room.id %>" name="check_out_date" required>

                                <button type="submit" class="btn btn-success">Book Now</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>

    <footer>
        <p>&copy; 2025 StayEase. All rights reserved.</p>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const today = new Date().toISOString().split("T")[0];

            document.querySelectorAll('input[type="date"]').forEach(dateInput => {
                if (dateInput.name === "check_in_date") {
                    dateInput.min = today; // ✅ Check-in date should allow today or future dates
                    dateInput.addEventListener("change", function () {
                        const checkInDate = new Date(this.value);
                        const checkOutInput = this.parentElement.querySelector('input[name="check_out_date"]');

                        if (checkOutInput) {
                            const nextDay = new Date(checkInDate);
                            nextDay.setDate(checkInDate.getDate() + 1);
                            checkOutInput.min = nextDay.toISOString().split("T")[0];
                            if (new Date(checkOutInput.value) <= checkInDate) {
                                checkOutInput.value = checkOutInput.min;
                            }
                        }
                    });
                }

                if (dateInput.name === "check_out_date") {
                    dateInput.addEventListener("click", function () {
                        if (!this.min) {
                            const checkInInput = this.parentElement.querySelector('input[name="check_in_date"]');
                            if (checkInInput && checkInInput.value) {
                                const checkInDate = new Date(checkInInput.value);
                                const nextDay = new Date(checkInDate);
                                nextDay.setDate(checkInDate.getDate() + 1);
                                this.min = nextDay.toISOString().split("T")[0];
                            }
                        }
                    });
                }
            });
        });
    </script>

    <!-- ✅ Register Service Worker for PWA -->
    <script>
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
                navigator.serviceWorker.register("/service-worker.js")
                    .then(() => console.log("Service Worker Registered"))
                    .catch(err => console.log("Service Worker Registration Failed", err));
            });
        }
    </script>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment - StayEase</title>
    <link rel="stylesheet" href="/css/payments.css">
</head>

<body>
    <header class="header-transparent">
        <h1 class="brand-title">Complete Your Payment</h1>
        <nav>
            <ul class="nav-list">
                <li><a href="/">Home</a></li>
                <li><a href="/rooms">Rooms</a></li>
                <li><a href="/bookings">Bookings</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/auth/logout" class="nav-logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div class="payment-container">
        <h2>Booking Details</h2>
        <div class="booking-info">
            <p><strong>Room:</strong>
                <%= booking.Room.room_number %> (<%= booking.Room.type %>)
            </p>
            <p><strong>Check-in:</strong>
                <%= booking.check_in_date %>
            </p>
            <p><strong>Check-out:</strong>
                <%= booking.check_out_date %>
            </p>
            <p><strong>Amount:</strong> $<%= parseFloat(booking.amount).toFixed(2) %>
            </p>
        </div>

        <h3>Choose Payment Method</h3>
        <form action="/payments/process" method="POST" id="payment-form">
            <input type="hidden" name="room_id" value="<%= booking.Room.id %>">
            <input type="hidden" name="check_in_date" value="<%= booking.check_in_date %>">
            <input type="hidden" name="check_out_date" value="<%= booking.check_out_date %>">
            <input type="hidden" name="amount" value="<%= parseFloat(booking.amount).toFixed(2) %>">

            <div class="payment-methods">
                <label>
                    <input type="radio" name="payment_method" value="credit_debit_card" required
                        onclick="togglePaymentForm(true)"> Credit/Debit Card
                </label>
                <label>
                    <input type="radio" name="payment_method" value="paypal" required
                        onclick="togglePaymentForm(false)"> PayPal
                </label>
            </div>

            <button type="submit" class="btn-primary">Proceed to Payment</button>
        </form>

        <!-- ✅ PayPal Button -->
        <div id="paypal-button-container" style="display: none;">
            <p>Click below to proceed with PayPal:</p>
            <div id="paypal-button"></div>
        </div>
    </div>

    <footer>
        <p>&copy; 2025 StayEase. All rights reserved.</p>
    </footer>

    <!-- ✅ Load PayPal SDK -->
    <script src="https://www.paypal.com/sdk/js?client-id=<%= process.env.PAYPAL_CLIENT_ID %>&currency=USD"></script>

    <script>
        function togglePaymentForm(showCard) {
            document.getElementById('paypal-button-container').style.display = showCard ? 'none' : 'block';
            if (!showCard) {
                renderPayPalButton();
            }
        }

        function renderPayPalButton() {
            document.getElementById('paypal-button').innerHTML = "";
            paypal.Buttons({
                createOrder: function (data, actions) {
                    return actions.order.create({
                        purchase_units: [{
                            amount: { value: "<%= parseFloat(booking.amount).toFixed(2) %>" }
                        }]
                    });
                },
                onApprove: function (data, actions) {
                    return actions.order.capture().then(function (details) {
                        alert('Transaction completed by ' + details.payer.name.given_name);
                        window.location.href = `/payments/paypal/success?paymentId=${data.orderID}&PayerID=${details.payer.payer_id}`;
                    });
                }
            }).render('#paypal-button');
        }
    </script>

</body>

</html>
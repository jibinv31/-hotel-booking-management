<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Bookings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header class="header-transparent">
        <h1 class="brand-title">Your Bookings</h1>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/rooms">Rooms</a></li>
                <li><a href="/payments">Payments</a></li>
                <li><a href="/auth/logout" class="nav-logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">
        <h2>Your Bookings</h2>
        <% if (bookings.length> 0) { %>
            <table class="table">
                <tr>
                    <th>Room</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
                <% bookings.forEach(booking=> { %>
                    <tr>
                        <td>Room <%= booking.Room.room_number %> (<%= booking.Room.type %>)</td>
                        <td>
                            <%= booking.check_in_date %>
                        </td>
                        <td>
                            <%= booking.check_out_date %>
                        </td>
                        <td>
                            <%= booking.status %>
                        </td>
                        <td>
                            <% if (booking.status==="pending" ) { %>
                                <a href="/payments/<%= booking.id %>" class="btn btn-primary">Pay Now</a>
                                <form action="/bookings/delete/<%= booking.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-danger">Cancel</button>
                                </form>
                                <% } %>
                        </td>
                    </tr>
                    <% }); %>
            </table>
            <% } else { %>
                <p>You have no bookings yet.</p>
                <% } %>
    </div>

    <footer>
        <p>&copy; 2025 StayEase. All rights reserved.</p>
    </footer>
</body>

</html>